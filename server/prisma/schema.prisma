// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  // Relations
  attendance       Attendance[]
  managedDivisions Division[]   @relation("FacultyDivisions")
  group            Group?       @relation("GroupStudents", fields: [groupId], references: [id])
  groupId          Int?
  groups           Group[] 
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  batchId   Int
  batch     Batch    @relation(fields: [batchId], references: [id])
  createdAt DateTime @default(now())
  group     Group?   @relation(fields: [groupId], references: [id])
  groupId   Int?
}

model Batch {
  id         Int       @id @default(autoincrement())
  name       String
  divisionId Int
  division   Division  @relation(fields: [divisionId], references: [id])
  students   Student[]
}

model Division {
  id   Int    @id @default(autoincrement())
  name String // e.g. "A", "B"

  faculty   User @relation("FacultyDivisions", fields: [facultyId], references: [id])
  facultyId Int

  batches Batch[]
}

model Group {
  id          Int    @id @default(autoincrement())
  name        String
  year        String
  branch      String
  division    String
  groupNumber String
  purpose     ProjectType
  joinCode    String      @unique

  tasks Task[]

  users      User[]       @relation("GroupStudents")
  attendance Attendance[]
  project    Project?
  Student    Student[]
  facultyId   Int
  faculty     User    @relation(fields: [facultyId], references: [id])


  @@unique([year, branch, division, groupNumber, purpose])
}

model Task {
  id       Int      @id @default(autoincrement())
  title    String
  deadline DateTime
  groupId Int
  completed Boolean  @default(false)
  
  group   Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

enum ProjectType {
  COURSE_PROJECT
  EDI
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  deadline    DateTime
  createdAt   DateTime @default(now())

  group   Group @relation(fields: [groupId], references: [id])
  groupId Int   @unique // ensures one project per group

  progress Progress[]
}

model Progress {
  id        Int      @id @default(autoincrement())
  details   String
  createdAt DateTime @default(now())

  project   Project @relation(fields: [projectId], references: [id])
  projectId Int
}

model Attendance {
  id     Int      @id @default(autoincrement())
  date   DateTime @default(now())
  status String // "PRESENT" or "ABSENT"

  userId Int
  user   User @relation(fields: [userId], references: [id])

  groupId Int
  group   Group @relation(fields: [groupId], references: [id])
}

enum Role {
  FACULTY
  STUDENT
}
