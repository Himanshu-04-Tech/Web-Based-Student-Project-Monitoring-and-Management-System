// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())

  // Relations
  createdGroups Group[]        @relation("FacultyGroups") // Faculty creates groups
  memberships   StudentGroup[] // Student joins groups
  divisions     Division[]     @relation("FacultyDivisions") // Faculty manages divisions
  attendance    Attendance[]
}

model Student {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  batchId   Int
  batch     Batch    @relation(fields: [batchId], references: [id])
  createdAt DateTime @default(now())
}

model Batch {
  id         Int       @id @default(autoincrement())
  name       String
  divisionId Int
  division   Division  @relation(fields: [divisionId], references: [id])
  students   Student[]
}

model Division {
  id        Int     @id @default(autoincrement())
  name      String // e.g. "A", "B"
  facultyId Int
  faculty   User    @relation("FacultyDivisions", fields: [facultyId], references: [id])
  batches   Batch[]
}

model Group {
  id          Int         @id @default(autoincrement())
  name        String
  year        String
  branch      String
  division    String
  groupNumber String
  purpose     ProjectType
  joinCode    String      @unique

  // Faculty who created this group
  facultyId Int
  faculty   User @relation("FacultyGroups", fields: [facultyId], references: [id])

  tasks      Task[]
  attendance Attendance[]
  project    Project?
  students   StudentGroup[] // Students in this group (via join table)

  @@unique([year, branch, division, groupNumber, purpose])
}

// Explicit join table — one student can be in multiple groups
model StudentGroup {
  id      Int @id @default(autoincrement())
  userId  Int
  groupId Int

  user  User  @relation(fields: [userId], references: [id])
  group Group @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId]) // prevent duplicate joins
}

model Task {
  id        Int      @id @default(autoincrement())
  title     String
  deadline  DateTime
  groupId   Int
  completed Boolean  @default(false)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

enum ProjectType {
  COURSE_PROJECT
  EDI
}

model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  createdAt   DateTime @default(now())

  groupId  Int        @unique // one project per group
  group    Group      @relation(fields: [groupId], references: [id])
  progress Progress[]
}

model Progress {
  id        Int      @id @default(autoincrement())
  details   String
  createdAt DateTime @default(now())

  projectId Int
  project   Project @relation(fields: [projectId], references: [id])
}

model Attendance {
  id     Int      @id @default(autoincrement())
  date   DateTime @default(now())
  status String // "PRESENT" or "ABSENT"

  userId  Int
  user    User  @relation(fields: [userId], references: [id])
  groupId Int
  group   Group @relation(fields: [groupId], references: [id])
}

enum Role {
  FACULTY
  STUDENT
}
